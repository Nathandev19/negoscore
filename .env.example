INTERNAL_MARK_SECRET=
# Adresse du propriétaire du site, lue à l'exécution par lib/admin/owner.ts.
# Absente ou vide : /admin et /dev/retours répondent comme des adresses
# inexistantes, POUR TOUT LE MONDE — y compris toi. Rien à l'écran ne dit que
# c'est la variable qui manque ; la raison du refus part dans les journaux.
# Pas une variable NEXT_PUBLIC_ : changer sa valeur demande un redéploiement
# pour qu'elle soit relue.
OWNER_EMAIL=
# Autres comptes à ne pas compter dans le cockpit, séparés par une virgule, un
# point-virgule ou un espace (lib/telemetry/internal.ts). Le propriétaire est
# interne d'office, il n'a pas à y figurer. Absente : le marquage interne par
# COMPTE ne marque plus rien, et les analyses faites depuis tes comptes de test
# entrent dans les chiffres comme celles d'une vraie visiteuse — en silence,
# puisqu'une ligne comptée à tort ressemble à une ligne normale.
INTERNAL_EMAILS=
NEXT_PUBLIC_SITE_URL=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_BUSINESS_ID=
WHOP_PLAN_PACK=
WHOP_PLAN_PRO=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_INBOUND_WEBHOOK_SECRET=
FORWARD_INBOUND_TO=
CRON_SECRET=
ANALYSIS_PAUSED=
