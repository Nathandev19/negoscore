# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# outils locaux
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# rendu Chromium local (profil, temporaires)
/.cache/

# maquette de référence du cockpit (#132), gardée hors du dépôt
/maquette-cockpit.html

# sorties de travail (briefs de marques, maquettes, PDF reçus). Mission #149 :
# le dépôt est public depuis le 04/10, et un « git add . » y publierait des
# documents qui n'ont rien à y faire. Le dossier n'était protégé par rien.
/Claude outputs/

# rendus de la carte de verdict (#168) : des images à regarder, pas des
# fichiers à versionner. Le test les réécrit à chaque passage.
/cartes-rendues/
