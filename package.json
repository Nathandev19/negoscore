{
  "name": "creator-deal-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:llm": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.llm.config.mts",
    "eval": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/run.ts",
    "eval:vision": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/run-vision.ts",
    "eval:vision:fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/vision/build-fixtures.ts",
    "eval:pipeline": "node --env-file-if-exists=.env.local --import ./evals/register-alias.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/pipeline.ts",
    "eval:rescore": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/rescore.ts",
    "eval:evaluability": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/evaluability.ts",
    "eval:effort": "node --env-file-if-exists=.env.local --import ./evals/register-alias.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/effort.ts",
    "eval:verbosity": "node --env-file-if-exists=.env.local --import ./evals/register-alias.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/effort.ts --experiment=verbosity",
    "negociation:enregistrer": "node --env-file-if-exists=.env.local --import ./evals/register-alias.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON evals/negotiation-record.ts",
    "email:templates": "node --import ./evals/register-alias.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/write-auth-templates.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.22.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
